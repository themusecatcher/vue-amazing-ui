# 构建产物（虽已在 .gitignore，此处显式声明，避免依赖 Prettier 的 gitignore 回退行为）
dist/
es/
lib/
dist-ssr/

# Markdown 一律不纳入格式化：docs/ 下的 md 是 md-as-SFC（顶层模板会被 Prettier 改写出行首 `>` 与标签失配，
# 直接导致 VitePress 构建失败，见 .github/workflows/verify.yml 文件头说明）；README / CONTRIBUTING / development
# 同为手写文档。故 format 脚本对全仓库生效，实际纳入的只有代码与配置类文件。
*.md

# 构建期生成的源码内中间产物（build/gen-theme.ts 在 buildStart 写出，已 gitignore）
/components/style/generated/

# 测试覆盖率
coverage/

# 依赖目录
node_modules/

# 锁文件：由 pnpm 生成，格式化会重排其结构，禁止纳入
pnpm-lock.yaml

# unplugin-vue-components 自动生成，内容随扫描时序抖动
components.d.ts

# VitePress 运行时产物（cache 依赖预构建、.temp 页面数据与 SSR 临时目录）
docs/.vitepress/cache/
docs/.vitepress/.temp/
docs/.vitepress/dist/
