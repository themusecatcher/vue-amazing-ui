{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "src/*.ts",
    "src/**/*.ts",
    "src/**/*.vue",
    "types/*.d.ts",
    "components/*.ts",
    "components/**/*.ts",
    "components/**/*.vue",
  ],
  "exclude": [
    "node_modules",
    "dist",
    "es",
    "lib"
  ],
  "compilerOptions": {
    "removeComments": true,
    "isolatedModules": true,
    "composite": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"],
      "#/*": ["./types/*"],
      "components/*": ["./components/*"],
      "less/*": ["./src/assets/less/*"]
    }
  }
}
