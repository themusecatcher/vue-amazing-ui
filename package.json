{
  "name": "vue-amazing-ui",
  "version": "2.7.3",
  "private": false,
  "type": "module",
  "author": "theMuseCatcher",
  "homepage": "https://themusecatcher.github.io/vue-amazing-ui",
  "description": "An Amazing Vue3 UI Components Library, Using TypeScript.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themusecatcher/vue-amazing-ui.git"
  },
  "keywords": [
    "Vue3",
    "TypeScript",
    "Vite",
    "Less",
    "SFC",
    "Amazing",
    "UI",
    "Components",
    "Tools",
    "Functions",
    "Tree Shaking"
  ],
  "files": [
    "dist",
    "es",
    "lib"
  ],
  "main": "lib/index.cjs",
  "module": "es/index.js",
  "unpkg": "dist/index.iife.js",
  "jsdelivr": "dist/index.iife.js",
  "types": "es/index.d.ts",
  "exports": {
    ".": {
      "types": "./es/index.d.ts",
      "import": "./es/index.js",
      "require": "./lib/index.cjs"
    },
    "./css": {
      "types": "./dist/css.d.ts",
      "default": "./dist/style.css"
    },
    "./*": "./*"
  },
  "sideEffects": [
    "dist/*.css",
    "*.css"
  ],
  "scripts": {
    "docs:dev": "vitepress dev docs --port 8000 --open",
    "docs:build": "vitepress build docs",
    "docs:deploy": "sh scripts/deploy.sh",
    "dev": "vite",
    "pub": "sh scripts/publish.sh",
    "push": "sh scripts/push.sh",
    "prepublishOnly": "node scripts/prepublish-guard.js",
    "build": "run-s clean build:components",
    "format": "prettier --write src/ components/",
    "format:check": "prettier --check src/ components/",
    "clean": "rimraf dist es lib",
    "build:components": "run-p type-check build:dist build:browser build-only",
    "type-check": "vue-tsc --build --force",
    "build:dist": "vite build -- dir=dist",
    "build:browser": "vite build -- dir=dist f=iife",
    "build-only": "vite build",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "check": "run-s lint:check format:check type-check test",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@ant-design/colors": "^8.0.1",
    "@ctrl/tinycolor": "^4.2.0",
    "@vuepic/vue-datepicker": "^12.1.0",
    "@vueuse/core": "^14.2.1",
    "csstype": "^3.2.3",
    "date-fns": "^4.1.0",
    "qrcode": "^1.5.4",
    "seemly": "^0.3.10",
    "swiper": "^12.1.2"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@tsconfig/node22": "^22.0.5",
    "@types/minimist": "^1.2.5",
    "@types/node": "^24.12.0",
    "@types/qrcode": "^1.5.6",
    "@types/spark-md5": "^3.0.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "2.5.0",
    "@vue/tsconfig": "^0.7.0",
    "ant-design-vue": "^4.2.6",
    "autoprefixer": "^10.5.5",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.8.0",
    "happy-dom": "^20.11.15",
    "husky": "^9.1.7",
    "less": "^4.5.1",
    "lint-staged": "^16.3.2",
    "minimist": "^1.2.8",
    "naive-ui": "^2.45.3",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.28",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "spark-md5": "^3.0.2",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-vue-devtools": "^8.0.7",
    "vitepress": "^1.6.4",
    "vitest": "4.1.11",
    "vue": "^3.5.42",
    "vue-amazing-ui": "2.7.2",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.2.5"
  },
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.24.0",
  "bugs": {
    "url": "https://github.com/themusecatcher/vue-amazing-ui/issues"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead"
  ],
  "lint-staged": {
    "*.{js,ts}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.vue": [
      "prettier --parser=vue --write",
      "eslint --fix"
    ],
    "*.{html,css,less}": [
      "prettier --write"
    ]
  }
}
