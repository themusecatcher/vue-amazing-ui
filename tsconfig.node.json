{
  "extends": "@tsconfig/node22/tsconfig.json",
  // 构建期 Node 侧唯一类型工程：vite/vitest/eslint 配置 + build/ 生成器 + scripts/ 开发期工具。
  // 三者同为 Node 环境、均无产物输出（noEmit），故共用一个工程，不按目录再拆分。
  "include": [
    "vite.config.*",
    "vitest.config.*",
    "cypress.config.*",
    "nightwatch.conf.*",
    "playwright.config.*",
    "eslint.config.*",
    "components/utils/vendor-styles.ts",
    "components/utils/style-deps.ts",
    "components/theme/**/*.ts",
    "components/utils/log.ts",
    "build/**/*.ts",
    "scripts/**/*.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "allowJs": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  }
}
