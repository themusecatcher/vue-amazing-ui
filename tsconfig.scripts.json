{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": ["scripts/**/*.ts"],
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "lib": ["ES2023"],
    "types": ["node"],
    // 构建期脚本的类型工程：scripts/**/*.ts 既不在 tsconfig.app.json 也不在 tsconfig.node.json 的 include 内，
    // 只能由本文件纳入 pnpm type-check（tests/ 与 docs/.vitepress 同样未被任何 tsconfig 覆盖，不在本文件范围）。
    "strict": true,
    "skipLibCheck": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo"
  }
}
